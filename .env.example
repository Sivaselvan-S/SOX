# ─── GriffSOX Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=griffsox_db

# Telemetry event TTL in days (MongoDB auto-expires old spans)
TELEMETRY_TTL_DAYS=30

# ─── Judge Mode ───────────────────────────────────────────────────────────────
# Options: "heuristic" | "ollama" | "gemini"
# Default: heuristic (no external LLM call — recommended for testing)
JUDGE_MODE=heuristic

# Ollama settings (only used when JUDGE_MODE=ollama)
JUDGE_OLLAMA_URL=http://localhost:11434/api/generate
JUDGE_OLLAMA_MODEL=llama3

# Gemini settings (only used when JUDGE_MODE=gemini)
JUDGE_GEMINI_API_KEY=your-gemini-api-key-here
JUDGE_GEMINI_MODEL=gemini-2.0-flash
JUDGE_TIMEOUT=5.0

# ─── SOAR Containment Endpoints ───────────────────────────────────────────────
# Leave blank to skip the HTTP call and gracefully mark the tier as successful.
LANGGRAPH_INTERRUPT_URL=
STS_REVOKE_URL=
DOCKER_EVICT_URL=

# ─── SIEM Webhook ─────────────────────────────────────────────────────────────
# Leave blank to disable SIEM dispatch.
SIEM_WEBHOOK_URL=

# ─── RBAC Policy ──────────────────────────────────────────────────────────────
# Path to a JSON file defining identity URN -> tool categories.
# Leave blank to use the built-in DEFAULT_POLICIES.
RBAC_POLICY_PATH=rbac_policy.json

# ─── CORS (Production) ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for production.
# Example: https://griffsox.vercel.app,https://griffsox.com
# Leave blank for local dev (auto-allows localhost:5173, localhost:3000).
ALLOWED_ORIGINS=

# ─── SQLite Finance DB Path (AWS Deployment) ──────────────────────────────────
# Override to mount a persistent EBS volume path on AWS ECS.
# Example: /mnt/efs/griffsox/finance_records.db
# Leave blank to use the default: <project_root>/data/finance_records.db
FINANCE_DB_PATH=
