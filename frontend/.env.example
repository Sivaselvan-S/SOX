# ─── GriffSOX Frontend Environment Variables ──────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Backend API Base URL ─────────────────────────────────────────────────────
# Required for production deployment on Vercel.
# Set this to your AWS backend URL (e.g. ALB DNS or API Gateway URL).
# Example: https://api.griffsox.com  or  https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_BASE=https://YOUR_AWS_BACKEND_URL

# ─── WebSocket Base URL ───────────────────────────────────────────────────────
# Required for production. Must use wss:// (secure WebSocket) when backend is on HTTPS.
# Example: wss://api.griffsox.com
VITE_WS_BASE=wss://YOUR_AWS_BACKEND_URL

# ─── Local Development ────────────────────────────────────────────────────────
# For local dev, leave both vars UNSET — the client auto-detects localhost:8000.
# You only need to set these when deploying to Vercel or a remote environment.
